	/**
	 * checkFileIsWriteable
	 * @param  string $fileName
	 * @return bool
	 *
	 *  Checks if a file exists in the Asterisk folder and opens it
	 *  If the file does not exist then create it and write a single comment into it
	 */
	private function checkFileIsWriteable($fileName)
	{

		if (!file_exists($fileName)) {
			$rc = $this->helper->request_syscmd("/bin/echo ';;;' > $fileName >/dev/null 2>&1");
			$rc = $this->helper->request_syscmd("/bin/chown asterisk:asterisk $fileName >/dev/null 2>&1");
			$rc = $this->helper->request_syscmd("/bin/chmod 664 $fileName >/dev/null 2>&1");
		}

		return True;
	}

	private function genMoh()
