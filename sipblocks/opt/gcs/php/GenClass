		/*
 * take a snapshot
 */
		$rc = $this->helper->request_syscmd("/bin/sh " . SCRIPTS . "/snap.sh");

		/*
 * reload asterisk
 */
		$rc = $this->helper->request_syscmd("sudo " . ASTEXEC . " -rx 'reload'");

		return;
	}
