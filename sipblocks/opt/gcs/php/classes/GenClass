					foreach ($orideclosedarray as $key => $value) {
						$OUT .= "\tinclude => " . $key . "\n";
					}

					$sql = 	"SELECT COS_pkey FROM IPphoneCOSclosed where IPphone_pkey='" . $IPphone['pkey'] . "'";
