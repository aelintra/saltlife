					}
					if ($mycos['orideclosed'] == 'YES') {
						$orideclosedarray[$mycos['pkey']] =	"YES";
					}
				}
				//
				//		now do the process 
				//							
				$sql = "SELECT * FROM IPphone ORDER BY pkey";
				$qRes = $this->dbh->query($sql);
				$cosphone = $qRes->fetchAll();
				$qRes = NULL;

				foreach ($cosphone as $IPphone) {
					$myCluster = $IPphone['cluster'];
