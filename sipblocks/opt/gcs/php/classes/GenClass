				$OUT .= "\texten => " . $row[KEYTYPE] . ",n,Set(DEVICE_STATE(Custom:" . $row[KEYTYPE] . ")=INUSE)\n";
				$OUT .= "\texten => " . $row[KEYTYPE] . ",n,Playback(activated)\n";
				$OUT .= "\texten => " . $row[KEYTYPE] . ",n,Hangup\n";
				$OUT .= "\n";
				$OUT .= "\texten => " . $row[KEYTYPE] . ",n(" . $row[KEYTYPE] . "open),Set(DB(" . $row[KEYTYPE] . "/OCSTAT)=AUTO)\n";
				$OUT .= "\texten => " . $row[KEYTYPE] . ",n,Set(DEVICE_STATE(Custom:" . $row[KEYTYPE] . ")=NOT_INUSE)\n";
				$OUT .= "\texten => " . $row[KEYTYPE] . ",n,Playback(de-activated)\n";
				$OUT .= "\texten => " . $row[KEYTYPE] . ",n,Hangup\n";
				$OUT .= "\n";
				$OUT .= "\texten => *33*,1,GoTo(" . $row[KEYTYPE] . ',' . $row[KEYTYPE] . "open)\n";
				$OUT .= "\texten => *34*,1,GoTo(" . $row[KEYTYPE] . ',' . $row[KEYTYPE] . "close)\n";
				$OUT .= "\n";
				//
				//  pickup marks
				//

				$OUT .= "\n\texten => _*8XX.,1,Pickup(\${EXTEN}@PICKUPMARK)\n\n";

				$OUT .= <<<HERE
;
;   Outbound Routes 
;	
HERE;
				$OUT .= "\n";
				$sql = "SELECT * FROM Route WHERE cluster='" . $row['id'] . "' ORDER BY pkey";
				$qRes = $this->dbh->query($sql);
				$route = $qRes->fetchAll();
				$qRes = NULL;
				foreach ($route as $routerow) {
