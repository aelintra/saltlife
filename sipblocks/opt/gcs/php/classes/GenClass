/**
 * 	Handle greetings here
 */
$OUT .= <<<HERE
;
;   Greetings playback extensions (if any)
;	
HERE;
$OUT .= "\n";
				$sql = "SELECT * FROM greeting WHERE cluster='" . $row['id'] . "' ORDER BY pkey";
