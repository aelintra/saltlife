/**
 *  Queues extensions are given entirely to Astqueues to handle
 * 	When the queue calls a target it calls the "Q" extension and we 
 *  send it directly to the endpoint
 */
					$OUT .= "\texten => Q" . $phone['pkey'] . ",1,Dial(PJSIP/" . $phone['id'] . ")\n";
 
					if ($phone['dvrvmail'] != "None") {
