			//  include custom apps
			//

			$sql = "select * from Appl";
			$qRes = $this->dbh->query($sql);
			$appl = $qRes->fetchAll();
			$qRes = NULL;
			foreach ($appl as $row) {
				if ($row['span'] == "Both" || $row['span'] == "External") {
