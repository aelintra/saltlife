				$orideclosedarray = array();
				//
				//      select the overrides first
				//
				$sql = "SELECT * FROM COS ORDER BY pkey";
				$qRes = $this->dbh->query($sql);
				$cos = $qRes->fetchAll();
				$qRes = NULL;

				foreach ($cos as $mycos) {
