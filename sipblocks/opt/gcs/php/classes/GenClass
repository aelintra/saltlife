				}
				$OUT .= <<<HERE
;
;   Direct trunk seize codes (if any)
;	
HERE;
				$OUT .= "\n";
				$sql = "SELECT * FROM lineIO WHERE cluster='" . $row['id'] . "' ORDER BY pkey";
				$qRes = $this->dbh->query($sql);
				$trunk = $qRes->fetchAll();
				$qRes = NULL;
				foreach ($trunk as $linerow) {
					if ($linerow['active'] == "YES" && $linerow['match'] != "") {
						$OUT .= "\texten => _" . $linerow['match'] . "X.,1,agi(" . SYSAGI . ",OutTrunk," . $linerow['pkey'] . ",,," . $linerow['cluster'] . ")\n";
					}
				}
				$OUT .= <<<HERE
;
;   ACD objects (page, callgroup, queue) 
;	
HERE;
				$OUT .= "\n";
				// Queues
				$sql = "SELECT * FROM Queue WHERE cluster='" . $row['id'] . "' ORDER BY pkey";
				$qRes = $this->dbh->query($sql);
				$queue = $qRes->fetchAll();
				$qRes = NULL;

				foreach ($queue as $qrow) {

					$OUT .= "\n;   Name: " . $qrow['name'] . " - " .$qrow['description']. "\n";
					$OUT .= "\texten => " . $qrow['pkey'] . ",1,Answer()\n";
					$outstring =  "\texten => " . $qrow['pkey'] . ",n,Queue(";
					$outstring .= $qrow['pkey'];
					$outstring .= ',';
					$outstring .= $qrow['options'];
					$outstring .= ',,,,';
					if ($qrow['devicerec'] != 'None') {
