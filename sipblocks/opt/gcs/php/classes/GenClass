				foreach ($phones as $phone) {
					$OUT .= ";  Endpoint: " . $phone['pkey'] . " - " . "SIP address: " . $phone['id'] . "\n";
					$OUT .= "\texten => " . $phone['pkey'] . ",hint,PJSIP/" . $phone['id'] . "\n";
					$OUT .= "\texten => " . $phone['pkey'] . ",1,GoTo(" . $phone['id'] . ",1)\n";
