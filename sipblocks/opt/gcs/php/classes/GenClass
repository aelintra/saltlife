			$lineio = $qRes->fetchAll();
			$qRes = NULL;
	
			foreach ($lineio as $row) {
				$OUT .= "\texten => " . $row['pkey'] . ",1,agi(" . SYSAGI . ",Visitors," . $row['pkey'] . ",,," . $row['cluster'] . ")\n";
			}
			$OUT .= <<<THERE

	exten => i,1,Playtones(congestion)
	exten => i,2,wait(5)
	exten => i,3,HangUp

THERE;

			//
			//  Internal presets and withhold CLID
			//	include these from separate files
			//

			$OUT .= "\n#include extensions_presets.conf\n";
			$OUT .= "\n#tryinclude extensions_withhold_clid.conf\n";
			

$OUT .= <<<HERE

;
;#####################################################################
;
;	Customer Supplied Contexts below this line (if any).
;
;#####################################################################

HERE;

			//
			// Custom Apps
			//	
			$OUT .= "\n";
			//	$sql = "select * from Appl";
			foreach ($appl as $row) {
				if (!empty($row['active'])) {
					if ($row['active'] != "YES") {
						continue;
					}
				}
				$OUT .= ";\n";
				$OUT .= ";\tCustomer Supplied Context " .  $row['pkey'] . "\n";
				$OUT .= ";\n";
				$OUT .= "[" .  $row['pkey'] . "]\n";
				$OUT .= $row['extcode'];
				$OUT .= ";\n";
			}

			// write the generated file 

			$myExtensions = ASTLOCALCONF . "/extensions.conf";
			$fh = fopen($myExtensions, 'w') or die('Could not open file extensions.conf!');
			fwrite($fh, $OUT) or die('Could not write to file extensions.conf');
			fclose($fh);
			// clean it
			system ("dos2unix $myExtensions >/dev/null 2>&1");
			//
			//	All done.	
			//
		} catch (PDOException $e) {
			$errorMsg = $e->getMessage();
			syslog(LOG_WARNING, "DB error in extension generate - $errorMsg");
		}
	}

	private function confBridge(&$OUT,$dbh)
	{
		$profile = 'pbx3_user';
		$sql = "SELECT * FROM meetme ORDER BY pkey";
		$qRes = $this->dbh->query($sql);
		$meetme = $qRes->fetchAll();
		$qRes = NULL; 

		foreach ($meetme as $room) {
		$OUT .= "\texten => " . $room['pkey'] . ",1,NoOp(conference " . $room['pkey'] . ")\n";
		$OUT .= "\tsame => n,Answer(500)\n";
		if ($room['pin'] and $room['pin'] != "None") {
			$OUT .= "\tsame => n,Authenticate(" . $room['pin'] . ")\n";
		}		 
		if ($room['type'] == "hosted" ) {			
			$profile = 'pbx3_hosted_user';
		}	
		$OUT .= "\tsame => n,ConfBridge(\${EXTEN},,$profile)\n";
		$OUT .= "\tsame => n,Hangup()\n";
	   }	
	}

